---
import DateTime from "../../DateTime.vue";
import LinkVcpkgCommit from "../../LinkVcpkgCommit.astro";
import MarkdownSubset from "./MarkdownSubset.astro";

interface Props {
  readonly class?: any;
  readonly latest?: boolean | undefined;
  readonly oldest?: boolean | undefined;
  readonly commit: string;
  readonly timestamp: string;
  readonly message: string;
}

const {
  class: classList,
  latest,
  oldest,
  commit,
  timestamp,
  message,
} = Astro.props;
---

<li
  class:list={[
    "flex items-start w-full",
    latest ? "light:text-green-600 dark:text-green-400" : "",
    classList || "",
  ]}
>
  <div class="flex-none flex flex-row items-center">
    <div
      class:list={[
        "flex-none text-2xl opacity-80",
        oldest ? "icon-[mdi--source-commit-end]" : "icon-[mdi--source-commit]",
      ]}
    >
    </div>
    <LinkVcpkgCommit
      class="block flex-none mr-1.5 max-sm:hidden"
      commit={commit}
    />
  </div>
  <div class="flex-1">
    <span>
      <LinkVcpkgCommit class="mr-1.5 sm:hidden" commit={commit} />
      <MarkdownSubset class="wrap-break-word" content={message} githubIssues />
    </span>
    <div class="float-right text-sm opacity-60 align-bottom pl-2 pt-1">
      <DateTime client:visible timestamp={timestamp} />
    </div>
    <div class="clear-both"></div>
  </div>
</li>
