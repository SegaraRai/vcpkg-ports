---
interface Props {
  readonly href?: string | undefined;
  readonly title?: string | undefined;
}

const { href, title } = Astro.props;
---

{
  href ? (
    <a
      class="icon-[mdi--alert] inline-block flex-none text-[85%] text-theme-warning select-none"
      href={href}
      title={title}
      target="_blank"
      rel="noreferrer"
    />
  ) : (
    <span
      class="icon-[mdi--alert] inline-block flex-none text-[85%] text-theme-warning select-none"
      title={title}
    />
  )
}
