---
interface Props {
  readonly href?: string | undefined;
  readonly title?: string | undefined;
}

const { href, title } = Astro.props;
---

{
  href ? (
    <a
      class="flex-none inline-block select-none text-[85%] icon-[mdi--alert] text-orange-500"
      href={href}
      title={title}
      target="_blank"
      rel="noreferrer"
    />
  ) : (
    <span
      class="flex-none inline-block select-none text-[85%] icon-[mdi--alert] text-orange-500"
      title={title}
    />
  )
}
