---
interface Props {
  readonly class?: any;
  readonly lang: string;
  readonly nosnippet?: boolean | undefined;
}

const { class: classList, lang, nosnippet } = Astro.props;
---

<div
  class:list={[
    "relative whitespace-normal! overflow-hidden p-0! bg-[#35312b] dark:bg-[#16130d] rounded-lg text-sm",
    `code-block language-${lang}`,
    classList || "",
  ]}
  data-nosnippet={nosnippet || undefined}
>
  <pre
    class="block max-h-80 overflow-auto px-5 py-3"
    tabindex="0"><code class="block w-full h-full" translate="no"><slot /></code></pre>
  <button
    class="copy absolute top-2 right-6 select-none transition-all duration-250 text-gray-300/60! w-8 h-8 p-1 flex items-center justify-center hover:bg-white/17 rounded"
    title="Copy Code"
  >
    <span
      class="icon opacity-0 block w-full h-full transition-opacity duration-250 relative"
      data-mode="initial"
    >
      <span class="icon-[mdi--clipboard-text-outline] icon-initial"></span>
      <span class="icon-[mdi--clipboard-check-outline] icon-copied"></span>
      <span class="icon-[mdi--clipboard-remove-outline] icon-failed"></span>
    </span>
    {
      lang !== "plaintext" && (
        <span
          class="lang block absolute top-0 right-1 pointer-events-none transition-opacity duration-250"
          translate="no"
          set:text={lang}
        />
      )
    }
  </button>
</div>

<style is:global>
  @reference "../../../styles/main.css";

  div.code-block > code > .line {
    @apply block;
    @apply whitespace-pre;
  }

  div.code-block:hover > .copy > .lang,
  div.code-block > .copy:focus > .lang {
    @apply opacity-0;
  }

  div.code-block:hover > .copy > .icon,
  div.code-block > .copy:focus > .icon {
    @apply opacity-100;
  }

  div.code-block > .copy > .icon > * {
    @apply block;
    @apply w-full;
    @apply h-full;
    @apply opacity-0;
    @apply transition-opacity duration-250;
  }

  div.code-block > .copy > .icon > :not(.icon-initial) {
    @apply absolute;
    @apply top-0;
    @apply left-0;
  }

  /*! beasties:include start */
  div.code-block > .copy > .icon[data-mode="initial"] > .icon-initial,
  div.code-block > .copy > .icon[data-mode="copied"] > .icon-copied,
  div.code-block > .copy > .icon[data-mode="failed"] > .icon-failed {
    @apply opacity-100;
  }
  /*! beasties:include end */
</style>

<script>
  const ICON_TIMEOUT = 2000;

  const copyAsync = async (button: HTMLElement): Promise<boolean> => {
    if (!navigator?.clipboard) {
      return false;
    }
    const code = button.parentElement?.querySelector("code");
    if (!code) {
      return false;
    }
    try {
      // oxlint-disable-next-line unicorn/prefer-dom-node-text-content
      await navigator.clipboard.writeText(code.innerText.trim() + "\n");
    } catch {
      return false;
    }
    return true;
  };

  const createCopyHandler = (button: HTMLElement): (() => void) => {
    const icon = button.querySelector<HTMLElement>(".icon");
    let timer: ReturnType<typeof setTimeout> | null = null;

    return (): void => {
      copyAsync(button).then((result): void => {
        if (!icon) {
          return;
        }

        icon.dataset.mode = result ? "copied" : "failed";
        if (timer != null) {
          clearTimeout(timer);
        }
        timer = setTimeout((): void => {
          icon.dataset.mode = "initial";
          timer = null;
        }, ICON_TIMEOUT);
      });
    };
  };

  const copyButtons = document.querySelectorAll<HTMLButtonElement>(
    "div.code-block>button.copy"
  );
  for (const button of copyButtons) {
    button.addEventListener("click", createCopyHandler(button));
  }
</script>
