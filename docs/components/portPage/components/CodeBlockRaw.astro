---
interface Props {
  readonly class?: any;
  readonly lang: string;
  readonly nosnippet?: boolean | undefined;
}

const { class: classList, lang, nosnippet } = Astro.props;
const copyLabel = lang === "plaintext" ? "Copy text" : `Copy ${lang}`;
---

<div
  class:list={[
    "group/code-block relative whitespace-normal! overflow-hidden rounded-lg bg-theme-code-block-bg p-0! text-sm",
    `language-${lang}`,
    classList || "",
  ]}
  data-code-block
  data-nosnippet={nosnippet || undefined}
>
  <pre
    class="block max-h-80 overflow-auto px-5 py-3"
    tabindex="0"><code data-copy-target class="block h-full w-full [&>.line]:block [&>.line]:whitespace-pre" translate="no"><slot /></code></pre>
  <button
    data-copy-button
    class="text-theme-code-block-control! hover:bg-theme-code-block-control-hover-bg absolute top-2 right-6 flex size-8 items-center justify-center rounded p-1 transition-all duration-250 select-none"
    title={copyLabel}
    aria-label={copyLabel}
  >
    <span
      data-copy-icon
      class="group/code-icons relative block h-full w-full opacity-0 transition-opacity duration-250 group-hover/code-block:opacity-100 group-focus-within/code-block:opacity-100"
      data-mode="initial"
    >
      <span
        class="icon-[mdi--clipboard-text-outline] absolute inset-0 block h-full w-full opacity-0 transition-opacity duration-250 group-data-[mode=initial]/code-icons:opacity-100"
      ></span>
      <span
        class="icon-[mdi--clipboard-check-outline] absolute inset-0 block h-full w-full opacity-0 transition-opacity duration-250 group-data-[mode=copied]/code-icons:opacity-100"
      ></span>
      <span
        class="icon-[mdi--clipboard-remove-outline] absolute inset-0 block h-full w-full opacity-0 transition-opacity duration-250 group-data-[mode=failed]/code-icons:opacity-100"
      ></span>
    </span>
    {
      lang !== "plaintext" && (
        <span
          class="absolute top-0 right-1 block pointer-events-none transition-opacity duration-250 group-hover/code-block:opacity-0 group-focus-within/code-block:opacity-0"
          translate="no"
          set:text={lang}
        />
      )
    }
  </button>
</div>

<script>
  const ICON_TIMEOUT = 2000;

  const copyAsync = async (button: HTMLElement): Promise<boolean> => {
    if (!navigator?.clipboard) {
      return false;
    }
    const code = button
      .closest("[data-code-block]")
      ?.querySelector<HTMLElement>("[data-copy-target]");
    if (!code) {
      return false;
    }
    try {
      // oxlint-disable-next-line unicorn/prefer-dom-node-text-content
      await navigator.clipboard.writeText(code.innerText.trim() + "\n");
    } catch {
      return false;
    }
    return true;
  };

  const createCopyHandler = (button: HTMLElement): (() => void) => {
    const icon = button.querySelector<HTMLElement>("[data-copy-icon]");
    let timer: ReturnType<typeof setTimeout> | null = null;

    const initialLabel = button.getAttribute("aria-label") ?? "Copy";

    return (): void => {
      copyAsync(button).then((result): void => {
        if (!icon) {
          return;
        }

        icon.dataset.mode = result ? "copied" : "failed";
        const statusLabel = result ? "Copied" : "Copy failed";
        button.setAttribute("aria-label", statusLabel);
        button.setAttribute("title", statusLabel);
        if (timer != null) {
          clearTimeout(timer);
        }
        timer = setTimeout((): void => {
          icon.dataset.mode = "initial";
          button.setAttribute("aria-label", initialLabel);
          button.setAttribute("title", initialLabel);
          timer = null;
        }, ICON_TIMEOUT);
      });
    };
  };

  const copyButtons =
    document.querySelectorAll<HTMLButtonElement>("[data-copy-button]");
  for (const button of copyButtons) {
    button.addEventListener("click", createCopyHandler(button));
  }
</script>
