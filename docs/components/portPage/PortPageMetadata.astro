---
import DateTime from "../DateTime.vue";

interface Props {
  readonly createdAt: string;
  readonly modifiedAt: string;
}

const { createdAt, modifiedAt } = Astro.props;

const items = [
  ["Created", createdAt, "datePublished", false],
  ["Updated", modifiedAt, "dateModified", true],
] as const;
---

<dl
  class="mt-5 grid grid-cols-2 gap-x-6 gap-y-2 text-[0.88rem] text-theme-text-light max-[639px]:grid-cols-1"
>
  {
    items.map(([label, datetime, itemProp, updated]) => (
      <div
        class:list={[
          "flex items-baseline gap-x-3",
          updated && "text-theme-text-accent",
        ]}
        data-nosnippet
      >
        <dt
          class="w-24 flex-none text-theme-text-muted font-semibold"
          set:text={label}
        />
        <dd class="flex-1">
          <DateTime client:load timestamp={datetime} itemProp={itemProp} long />
        </dd>
      </div>
    ))
  }
</dl>
