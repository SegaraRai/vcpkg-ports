---
import DateTime from "../DateTime.vue";

interface Props {
  readonly modifiedAt: string;
}

const { modifiedAt } = Astro.props;
---

<dl class="mt-5 text-[0.88rem] text-theme-text-accent">
  <div class="flex items-baseline gap-x-3" data-nosnippet>
    <dt class="font-semibold text-theme-text-muted">Updated</dt>
    <dd>
      <DateTime client:load timestamp={modifiedAt} itemProp="dateModified" />
    </dd>
  </div>
</dl>
