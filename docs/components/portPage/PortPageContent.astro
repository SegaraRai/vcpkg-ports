---
import type { MarkdownHeading } from "astro";
import type { PortFrontmatter } from "../../../shared/dataTypes/frontmatter.mjs";
import TableOfContents from "../TableOfContents.vue";
import MoreMenu from "./MoreMenu.astro";
import PortPageMetadata from "./PortPageMetadata.astro";

interface Props {
  readonly frontmatter: PortFrontmatter;
  readonly headings: readonly MarkdownHeading[];
}

const { frontmatter, headings } = Astro.props as Props;
const { portName, portVersion } = frontmatter;
---

<article
  id="article"
  class="@container/port-content min-w-0"
  itemscope
  itemtype="https://schema.org/Article"
>
  <header class="mb-11 border-b border-theme-divider pb-9">
    <nav
      class="mb-7 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.82rem] text-theme-text-muted"
      aria-label="Breadcrumbs"
    >
      <a
        class="text-inherit no-underline hover:text-theme-text-accent hover:underline focus-visible:text-theme-text-accent focus-visible:underline"
        href="/">Home</a
      >
      <span aria-hidden="true">/</span>
      <a
        class="text-inherit no-underline hover:text-theme-text-accent hover:underline focus-visible:text-theme-text-accent focus-visible:underline"
        href="/ports">Catalog</a
      >
      <span aria-hidden="true">/</span>
      <span aria-current="page" translate="no" set:text={portName} />
    </nav>
    <h1
      id="overview"
      class="page-title m-0 flex flex-wrap items-baseline gap-x-3 gap-y-1 wrap-anywhere"
      translate="no"
      itemprop="headline"
    >
      <span set:text={portName} />
      <span
        class="text-[clamp(1rem,2vw,1.45rem)] font-semibold text-theme-text-muted"
        set:text={`v${portVersion}`}
      />
    </h1>
    <PortPageMetadata modifiedAt={frontmatter.modifiedAt} />
  </header>

  <div class="block lg:hidden">
    <nav
      class="my-5 mb-6 rounded-[0.85rem] border border-theme-divider bg-theme-surface p-3 lg:hidden"
      aria-label="On this page"
    >
      <div data-nosnippet>
        <!-- hydration is disabled as this TOC is not interactive -->
        <TableOfContents headings={headings} />
      </div>
    </nav>
  </div>

  <div class="rendered max-w-208">
    <slot />
  </div>

  <div class="block lg:hidden">
    <nav
      class="my-5 rounded-[0.85rem] border border-theme-divider bg-theme-surface p-3 lg:hidden"
      aria-label="Repositories"
    >
      <div data-nosnippet>
        <MoreMenu />
      </div>
    </nav>
  </div>
</article>
