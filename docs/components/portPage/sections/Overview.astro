---
import SectionWrapper from "../SectionWrapper.astro";
import MarkdownSubset from "../components/MarkdownSubset.astro";
import { type SectionProps, defineSection } from "../defineSection.mjs";

type Props = SectionProps;

export const getSection = defineSection({
  title: "Overview",
  noHeading: true,
});

const {
  context: { description },
  section,
} = Astro.props;
---

<SectionWrapper section={section}>
  {
    !!description && (
      <MarkdownSubset
        class="mt-0 overflow-hidden text-ellipsis text-[clamp(1.05rem,2vw,1.2rem)] leading-[1.65]"
        content={description}
        newline="break"
      />
    )
  }
</SectionWrapper>
