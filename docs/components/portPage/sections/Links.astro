---
import LinkExternal from "../../LinkExternal.astro";
import SectionWrapper from "../SectionWrapper.astro";
import { type SectionProps, defineSection } from "../defineSection.mjs";

type Props = SectionProps;

export const getSection = defineSection({
  title: "Links",
  noHeading: true,
});

const {
  context: {
    manifest: { documentation, homepage },
  },
  section,
} = Astro.props;

const links = (
  [
    ["Project website", homepage ?? ""],
    ["Documentation", documentation ?? ""],
  ] as const
).filter(([, url]) => url);
---

{
  !!links.length && (
    <SectionWrapper section={section}>
      <ul class="plain-list m-0 grid list-none gap-[0.6rem] p-0 leading-tight">
        {links.map(([label, url]) => (
          <li class="min-w-0 wrap-break-word">
            {label ? `${label}: ` : undefined}
            <LinkExternal
              class="inline-flex max-w-full items-baseline wrap-anywhere"
              href={url}
            />
          </li>
        ))}
      </ul>
    </SectionWrapper>
  )
}
