---
import type { MarkdownHeading } from "astro";
import TableOfContents from "../TableOfContents.vue";
import MoreMenu from "./MoreMenu.astro";

interface Props {
  readonly headings: readonly MarkdownHeading[];
}

const { headings } = Astro.props as Props;
---

<nav
  class="sticky top-30 max-h-[calc(100vh-7rem)] overflow-auto border-l border-theme-divider-strong py-3 pr-2 pl-4 text-theme-text-light"
  aria-label="On this page"
>
  <div class="grid gap-8" data-nosnippet>
    <TableOfContents
      highlight
      client:media="(min-width: 1024px)"
      headings={headings}
    />
    <MoreMenu />
  </div>
</nav>
