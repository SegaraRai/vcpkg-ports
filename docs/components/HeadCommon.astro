---
import "../styles/theme.css";
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width" />

<!--#__CSP_PLACEHOLDER__#-->

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />

<script is:inline>
  // Keep keyboard shortcut labels in sync without waiting for hydration.
  document.documentElement.dataset.keyboard = (() => {
    try {
      const userAgentData = Reflect.get(navigator, "userAgentData");
      const platform =
        userAgentData?.platform ||
        navigator.platform ||
        navigator.userAgent ||
        "";
      return /Mac|iPhone|iPod|iPad/i.test(platform) ? "mac" : "ctrl";
    } catch {
      return "ctrl";
    }
  })();

  // prevent FOUC. note that
  // - inlined scripts are embedded as-is, meaning that we can't use TypeScript here
  // - we cannot use type="module" because it makes the script load deferred, which is not what we want
  // - minification is done by the astro-compress integration
  document.documentElement.dataset.theme = (() => {
    try {
      const theme = localStorage.getItem("theme");
      return !theme || theme === "auto"
        ? matchMedia("(prefers-color-scheme:dark)").matches
          ? "dark"
          : "light"
        : theme === "dark"
          ? "dark"
          : "light";
    } catch {
      return "light";
    }
  })();
</script>
