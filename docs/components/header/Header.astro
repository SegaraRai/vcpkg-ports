---
import ManagedSearchBoxButton from "../search/ManagedSearchBoxButton.vue";
import SkipToContent from "./SkipToContent.astro";
import ThemeToggleButton from "./ThemeToggleButton.vue";

interface Props {
  readonly hideSearch?: boolean | undefined;
  readonly isHome?: boolean | undefined;
}

const { hideSearch, isHome } = Astro.props;

const LinkElement = isHome ? "span" : "a";
---

<header
  class="flex-none sticky top-0 z-90 flex flex-col items-center justify-center h-14 bg-(--theme-navbar-bg) w-full"
>
  <SkipToContent />
  <nav
    class="relative flex-1 block w-full h-full max-w-204 lg:max-w-296 px-8"
    title="Top Navigation"
  >
    <div
      class="max-lg:-mx-4 h-full flex items-center justify-between gap-x-8"
      data-nosnippet
    >
      <div class="flex-none">
        <LinkElement
          class:list={[
            "flex items-center select-none text-(--theme-text) leading-tight",
            !isHome &&
              "transition-colors duration-200 light:hover:text-(--theme-text-light) light:active:text-(--theme-text-light) dark:hover:text-(--theme-text-accent) dark:active:text-(--theme-text-accent)",
          ]}
          href={isHome ? undefined : "/"}
          aria-label="Vcpkg Ports"
          translate="no"
        >
          <span class="flex-none icon-[noto--package] size-10.5"></span>
          <span class="ml-2 flex-1 text-3xl pb-1 max-sm:hidden">
            <span class="font-bold">Vcpkg</span>
            <span class="font-normal">Ports</span>
          </span>
        </LinkElement>
      </div>
      <slot />
      <div
        class:list={[
          "flex items-center justify-end gap-x-4",
          hideSearch ? "flex-none" : "flex-1 max-w-80",
        ]}
        data-nosnippet
      >
        {
          !hideSearch && (
            <div class="flex-1">
              <ManagedSearchBoxButton client:load />
            </div>
          )
        }
        <div class="flex-none">
          <ThemeToggleButton client:load />
        </div>
      </div>
    </div>
  </nav>
</header>
