---
import ManagedSearchBoxButton from "../search/ManagedSearchBoxButton.vue";
import SkipToContent from "./SkipToContent.astro";
import ThemeToggleButton from "./ThemeToggleButton.vue";

interface Props {
  readonly hideSearch?: boolean | undefined;
  readonly isHome?: boolean | undefined;
}

const { hideSearch, isHome } = Astro.props;

const LinkElement = isHome ? "span" : "a";
---

<header
  class="sticky top-0 z-90 w-full border-b border-(--theme-navbar-text)/15 bg-theme-navbar-bg text-theme-navbar-text shadow-(--theme-shadow-navbar) backdrop-blur-lg"
>
  <SkipToContent />
  <nav
    class="mx-auto flex min-h-17 w-full max-w-7xl items-center gap-6 px-6 max-sm:min-h-15 max-sm:gap-2.5 max-sm:px-3"
    aria-label="Primary navigation"
  >
    <LinkElement
      class:list={[
        "site-brand inline-flex min-w-max items-center text-theme-navbar-text no-underline transition-colors duration-200 hover:text-theme-text-accent select-none",
        !isHome && "transition-colors duration-200",
      ]}
      href={isHome ? undefined : "/"}
      aria-label="Vcpkg Ports home"
      translate="no"
    >
      <span
        class="icon-[noto--package] block size-10 flex-none max-sm:size-[2.15rem]"
      ></span>
      <span
        class="ml-2.5 inline-flex items-baseline gap-1 text-[1.55rem] leading-none tracking-[-0.045em] max-sm:ml-1.5 max-sm:text-xl max-compact:hidden"
      >
        <strong class="font-extrabold">Vcpkg</strong>
        <span class="font-normal text-theme-navbar-muted">Ports</span>
      </span>
    </LinkElement>
    <slot />
    <div
      class="flex min-w-0 flex-1 items-center justify-end gap-2.5 max-sm:gap-1.5"
      data-nosnippet
    >
      {
        !isHome && (
          <a
            class="inline-flex min-h-10 items-center rounded-xl px-3.5 py-2 text-sm font-semibold whitespace-nowrap text-theme-navbar-muted no-underline hover:bg-(--theme-navbar-text)/10 hover:text-theme-navbar-text max-sm:hidden"
            href="/ports"
          >
            Catalog
          </a>
        )
      }
      {
        !hideSearch && (
          <div class="@container/search-trigger min-w-0 w-full max-w-88 max-sm:w-10">
            <ManagedSearchBoxButton client:load />
          </div>
        )
      }
      <ThemeToggleButton client:load />
    </div>
  </nav>
</header>
