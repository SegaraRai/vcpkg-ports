---
import headCommit from "../../virtual/headCommit.mjs";
import portNames from "../../virtual/portNames.mjs";
import DateTime from "../DateTime.vue";
---

<footer
  class="flex min-h-13 items-center justify-center border-t border-theme-divider bg-theme-surface px-4 py-3 text-[0.8rem] text-theme-text-muted"
>
  <div
    class="flex flex-wrap justify-center gap-x-3 gap-y-2 text-center"
    data-nosnippet
  >
    <span>
      Registry updated{" "}
      <DateTime client:load timestamp={headCommit.committer[0]} />
    </span>
    <span aria-hidden="true">·</span>
    <span set:text={`${portNames.length.toLocaleString("en")} ports`} />
    <span aria-hidden="true">·</span>
    <a class="link" href="/data.html">Data API</a>
  </div>
</footer>
