---
import SearchPageContent from "../components/search/SearchPageContent.vue";
import SearchPageSearchBox from "../components/search/SearchPageSearchBox.vue";
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout
  hideSearch
  title="Search vcpkg ports"
  description="Search vcpkg ports by name or description."
>
  <div slot="header" class="min-w-0 flex-1">
    <div class="mx-auto w-full max-w-152">
      <SearchPageSearchBox client:idle />
    </div>
  </div>
  <article id="article" class="mx-auto w-full max-w-208 px-5 pt-10 pb-20">
    <div class="w-full">
      <SearchPageContent client:load />
    </div>
  </article>
</MainLayout>
