---
import HeadingAnchor from "../components/HeadingAnchor.astro";
import LinkPortPage from "../components/LinkPortPage.astro";
import MainLayout from "../layouts/MainLayout.astro";
import portNames from "../virtual/portNames.mjs";

const categories = [..."#ABCDEFGHIJKLMNOPQRSTUVWXYZ"].map((letter) => {
  return {
    slug: letter.toLowerCase().replace("#", "num"),
    title: letter,
    letter,
    portNames: portNames.filter(
      letter === "#"
        ? (portName) => /^[^a-z]/i.test(portName)
        : (portName) => portName.toUpperCase().startsWith(letter)
    ),
  };
});
---

<MainLayout
  title="Port Catalog"
  description="Browse vcpkg ports by name and view package details."
>
  <article id="article" class="catalog-page">
    <header class="mb-8 flex items-start justify-between gap-4 max-sm:block">
      <div>
        <h1 class="page-title mb-0">Port Catalog</h1>
        <p class="catalog-summary max-sm:mt-2">
          Choose a letter or search by name.
        </p>
      </div>
      <div
        class="grid flex-none justify-items-end gap-1 text-right text-[0.82rem] text-theme-text-muted max-sm:mt-4 max-sm:flex max-sm:items-baseline max-sm:justify-start max-sm:gap-2 max-sm:text-left self-end"
      >
        <strong
          class="text-[1.8rem] leading-none tracking-[-0.04em] text-theme-text max-sm:text-[1.35rem]"
          >{portNames.length.toLocaleString()}</strong
        >
        <span>ports in the registry</span>
      </div>
    </header>
    <nav
      class="mb-10 flex flex-wrap gap-2 border-t border-theme-divider py-3"
      aria-label="Jump to a letter"
      translate="no"
    >
      <span
        class="mr-1 inline-flex min-h-8 items-center text-[0.78rem] font-bold tracking-[0.08em] text-theme-text-muted uppercase"
        >Jump to</span
      >
      {
        categories.map(
          ({ slug, title, portNames }) =>
            !!portNames.length && (
              <a
                class="inline-flex min-h-8 min-w-8 items-center justify-center rounded-lg px-1.5 font-bold text-theme-text-accent no-underline hover:bg-theme-bg-accent hover:text-theme-text-accent-hover"
                href={`#${slug}`}
                aria-label={`Jump to ${title} ports`}
              >
                {title}
              </a>
            )
        )
      }
    </nav>
    <section
      class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,15rem),1fr))] items-start gap-x-5 gap-y-10 max-sm:grid-cols-1 max-sm:gap-y-6"
      translate="no"
    >
      {
        categories.map(
          ({ slug, title, portNames }) =>
            !!portNames.length && (
              <section
                class="min-w-0 border-t border-theme-divider pt-3 target:scroll-mt-24 target:border-theme-text-accent"
                id={slug}
                aria-labelledby={`${slug}-title`}
              >
                <h2
                  id={`${slug}-title`}
                  class="section-heading section-heading-2 has-anchor mb-3 flex items-center gap-2 tracking-[0.04em]"
                >
                  <HeadingAnchor slug={slug} />
                  {title}
                </h2>
                <ol class="catalog-links">
                  {portNames.map((portName) => (
                    <li>
                      <LinkPortPage
                        class="link block wrap-anywhere rounded-md px-2 py-1 no-underline hover:bg-theme-bg-accent"
                        translate={null}
                        port={portName}
                      />
                    </li>
                  ))}
                </ol>
              </section>
            )
        )
      }
    </section>
  </article>
</MainLayout>
