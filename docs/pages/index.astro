---
import SearchBoxForHome from "../components/search/SearchBoxForHome.vue";
import MainLayout from "../layouts/MainLayout.astro";
import portNames from "../virtual/portNames.mjs";
---

<MainLayout hideSearch isHome>
  <article
    id="article"
    class="mx-auto flex h-full min-h-0 w-full max-w-7xl items-center px-[clamp(1rem,3vw,2rem)] pt-[clamp(2.5rem,7vh,5rem)] pb-[clamp(3rem,8vh,6rem)] max-sm:h-auto max-sm:items-start max-sm:px-4 max-sm:pt-10 max-sm:pb-14 max-compact:px-3"
  >
    <section
      class="relative isolate flex min-h-128 w-full min-w-0 items-center overflow-visible max-sm:min-h-0 max-sm:text-center"
      aria-labelledby="home-title"
    >
      <div
        class="pointer-events-none absolute top-1/2 right-8 z-0 size-64 -translate-y-1/2 max-lg:hidden xl:right-24 xl:size-[clamp(18rem,29vw,25rem)]"
        aria-hidden="true"
      >
        <div
          class="absolute inset-[-28%] rounded-full bg-theme-bg-accent opacity-60 blur-3xl"
        >
        </div>
        <div
          class="icon-[noto--package] relative size-full -rotate-3 opacity-70 drop-shadow-(--theme-shadow-hero-icon)"
        >
        </div>
      </div>
      <div
        class="relative z-10 flex w-full max-w-176 flex-col items-start max-sm:items-center"
      >
        <div class="page-eyebrow mt-0 mb-1">C++ package discovery</div>
        <h1
          id="home-title"
          class="home-title max-sm:max-w-[11ch]"
          translate="no"
        >
          Find your next vcpkg port
        </h1>
        <p class="home-description">
          Search the registry by package name or description, then open the
          exact version and dependency details you need.
        </p>
        <div id="home-search" class="@container/home-search mt-8 w-full">
          <SearchBoxForHome client:load />
        </div>
        <a
          class="link mt-6 inline-flex items-center gap-2 text-[1.02rem] font-semibold no-underline"
          href="/ports"
        >
          Browse all ports <span aria-hidden="true">→</span>
        </a>
        <div
          class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.82rem] text-theme-text-muted max-sm:justify-center"
        >
          <span>{portNames.length.toLocaleString()} ports indexed</span>
          <span class="max-sm:hidden" aria-hidden="true">·</span>
          <span><kbd>⌘ /</kbd> or <kbd>Ctrl K</kbd> opens search anywhere.</span
          >
        </div>
      </div>
    </section>
  </article>
</MainLayout>
