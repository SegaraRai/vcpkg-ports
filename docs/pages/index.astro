---
import SearchBoxForHome from "../components/search/SearchBoxForHome.vue";
import MainLayout from "../layouts/MainLayout.astro";
import portNames from "../virtual/portNames.mjs";
---

<MainLayout hideSearch isHome>
  <article
    id="article"
    class="mx-auto flex h-full min-h-0 w-full max-w-[52rem] items-center px-[clamp(1rem,4vw,2rem)] pt-[clamp(2.5rem,7vh,5rem)] pb-[clamp(3rem,8vh,6rem)] max-[639px]:h-auto max-[639px]:items-start max-[639px]:px-4 max-[639px]:pt-10 max-[639px]:pb-14 max-[374px]:px-3"
  >
    <section
      class="flex w-full min-w-0 flex-col items-start overflow-visible max-[639px]:items-center max-[639px]:text-center"
      aria-labelledby="home-title"
    >
      <div
        class="icon-[noto--package] size-[clamp(5rem,11vw,7rem)] drop-shadow-(--theme-shadow-hero-icon)"
        aria-hidden="true"
      >
      </div>
      <div class="page-eyebrow mb-1">C++ package discovery</div>
      <h1
        id="home-title"
        class="home-title max-[639px]:max-w-[11ch]"
        translate="no"
      >
        Find your next vcpkg port
      </h1>
      <p class="home-description">
        Search the registry by package name or description, then open the exact
        version and dependency details you need.
      </p>
      <div id="home-search" class="mt-8 w-full">
        <SearchBoxForHome client:load />
      </div>
      <a
        class="link mt-6 inline-flex items-center gap-2 text-[1.02rem] font-semibold no-underline"
        href="/ports"
      >
        Browse all ports <span aria-hidden="true">→</span>
      </a>
      <div
        class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.82rem] text-theme-text-muted max-[639px]:justify-center"
      >
        <span>{portNames.length.toLocaleString()} ports indexed</span>
        <span class="max-[639px]:hidden" aria-hidden="true">·</span>
        <span><kbd>⌘ /</kbd> or <kbd>Ctrl K</kbd> opens search anywhere.</span>
      </div>
    </section>
  </article>
</MainLayout>
