---
import MainLayout from "../layouts/MainLayout.astro";

const dataLabels: Record<string, string> = {
  "og-index.json": "Preview metadata",
  "vcpkg-history.json": "Registry history",
  "vcpkg-ports.json": "Port index",
  "vcpkg-version.json": "Registry version",
};

const dataFilenames = Object.keys(import.meta.glob("./data/*.json.*"))
  .map((filename) =>
    // oxlint-disable-next-line @typescript-eslint/no-non-null-assertion
    filename
      .split("/")
      .pop()!
      .replace(/\.[^.]+$/, "")
  )
  .sort();
---

<MainLayout
  fixedHeight
  title="Data API"
  description="Download the port index, versions, and registry history as JSON."
>
  <article id="article" class="catalog-page">
    <div class="page-eyebrow">Developer tools</div>
    <h1 class="page-title mt-1 mb-0">Data API</h1>
    <p class="catalog-summary">Download registry data as JSON.</p>
    <ul class="catalog-links mt-6" translate="no">
      {
        dataFilenames.map((filename) => {
          return (
            <li>
              <a
                class="link block wrap-anywhere rounded-md px-2 py-1 no-underline hover:bg-theme-bg-accent"
                target="_blank"
                href={`/data/${filename}`}
              >
                <span set:text={dataLabels[filename] ?? filename} />
                <code
                  class="ml-2 text-sm text-theme-text-muted"
                  set:text={`/data/${filename}`}
                />
              </a>
            </li>
          );
        })
      }
    </ul>
  </article>
</MainLayout>
