---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout fixedHeight is404 title="Not Found">
  <article
    id="article"
    class="h-full overflow-hidden flex flex-col gap-y-4 items-center justify-center text-center"
  >
    <h1
      class="flex-none flex flex-col items-center justify-center gap-x-4 gap-y-4 mt-4 mb-8 text-4xl leading-tight opacity-80"
    >
      <div
        class="flex-none w-32 h-32 sm:w-48 sm:h-48 icon-[mdi--package-variant]"
      >
      </div>
      <div>
        <span>404</span>
        <span class="whitespace-nowrap">Not Found</span>
      </div>
    </h1>
    <div class="text-base text-(--theme-text-light) leading-tight">
      <p class="mb-8">The page you are looking for does not exist.</p>
      <a href="/" class="link text-base font-bold!">Home</a>
    </div>
  </article>
</MainLayout>
