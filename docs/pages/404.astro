---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout fixedHeight is404 title="Not Found">
  <article
    id="article"
    class="mx-auto flex min-h-[calc(100dvh-7.5rem)] w-full max-w-3xl flex-col items-center justify-center px-4 py-12 text-center"
  >
    <div class="icon-[mdi--package-variant] size-24" aria-hidden="true"></div>
    <h1 class="home-title">Page not found</h1>
    <p class="home-description">The link may be outdated.</p>
    <div class="mt-4 flex flex-wrap justify-center gap-3">
      <a href="/" class="button-primary">Search ports</a>
      <a href="/ports" class="link inline-flex items-center px-3 py-2"
        >Browse catalog</a
      >
    </div>
  </article>
</MainLayout>
