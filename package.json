{
  "name": "vcpkg-ports",
  "version": "1.0.0",
  "author": "SegaraRai",
  "type": "module",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "astro": "astro",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "pnpm run lint:js && pnpm run lint:style",
    "lint:js": "vp check && pnpm run fmt:astro",
    "lint:style": "stylelint \"**/*.{css,scss}\" --ignore-path .gitignore",
    "lint:fix": "vp lint . --fix && vp fmt . && pnpm run fmt:astro:fix && pnpm run lint:style -- --fix",
    "fmt:astro": "prettier --check \"**/*.astro\"",
    "fmt:astro:fix": "prettier --write \"**/*.astro\"",
    "generate": "pnpm run generate:data && pnpm run generate:images",
    "generate:data": "tsx scripts/bin/generateDataPorts.mts && tsx scripts/bin/generateDataHistory.mts",
    "generate:fonts": "tsx scripts/bin/generateFonts.mts",
    "generate:images": "tsx scripts/bin/generateImages.mts",
    "validate:manifests": "tsx scripts/bin/validatePortManifests.mts",
    "validate:portfiles": "tsx scripts/bin/parsePortfiles.mts",
    "validate:sync": "tsx scripts/bin/checkDataSync.mts",
    "sync:deps": "taze -w major && pnpm i && pnpm up",
    "sync:vcpkg": "cd .vcpkg && git checkout master && git pull --ff-only --depth=200 origin master && cd .. && pnpm run validate:manifests && pnpm run validate:portfiles && pnpm run generate:data",
    "sync:vcpkg-full": "cd .vcpkg && git checkout master && git reset --hard && git pull --ff-only --unshallow origin master && cd .. && pnpm run validate:manifests && pnpm run validate:portfiles && pnpm run generate:data --no-incremental",
    "typecheck": "astro check && vue-tsc",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vue": "^7.0.2",
    "@babel/core": "^8.0.1",
    "@iconify/json": "^2.2.517",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.2.0",
    "@unocss/astro": "^66.7.5",
    "@unocss/preset-wind3": "^66.7.5",
    "@unocss/reset": "^66.7.5",
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "astro": "^7.2.2",
    "astro-compress": "^2.4.3",
    "beasties": "^0.4.3",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "fontkit": "^2.0.4",
    "fuse.js": "^7.5.0",
    "globals": "^17.11.0",
    "html-entities": "^2.6.0",
    "jsep": "^1.4.0",
    "linkify-it": "^6.1.0",
    "postcss": "^8.5.26",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "rollup": "^4.62.4",
    "sass": "^1.102.0",
    "schema-dts": "^2.0.0",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "spdx-license-list": "^6.12.0",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "subset-font": "^2.5.0",
    "taze": "^21.1.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "unocss": "^66.7.5",
    "unplugin-icons": "^23.0.1",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.10",
    "wrangler": "^4.123.0",
    "zod": "^4.4.3"
  }
}
